# Copy this file to .env.local and fill in real values from your Supabase
# project's dashboard: Settings → API. .env.local is gitignored — never
# commit real keys.
#
# The anon key is safe to expose in client code BY DESIGN — every table has
# RLS enabled and forced (see backend/migrations/0002_rls.sql), so the anon
# key alone grants nothing; the database itself decides what each signed-in
# person may see or do. See backend/README.md if this feels surprising.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
